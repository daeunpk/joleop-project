PROJECT_NAME=Children English Story Learning API
VERSION=0.1.0
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@RDS_ENDPOINT:5432/story_learning
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256

CORS_ORIGINS=https://YOUR_FRONTEND_DOMAIN

PARENT_ACCESS_TOKEN_EXPIRE_MINUTES=60
PARENT_REFRESH_TOKEN_EXPIRE_DAYS=14
PROFILE_ACCESS_TOKEN_EXPIRE_MINUTES=180
MAX_CHILD_PROFILES_PER_PARENT=5
MAX_AUDIO_UPLOAD_BYTES=10485760

COMPLETION_REWARD_HEARTS=10
COMPLETION_REWARD_ENERGY=0
ENERGY_RECHARGE_MINUTES=15

TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-JennyNeural
EDGE_TTS_CACHE_DIR=/tmp/tts-cache

STT_PROVIDER=faster-whisper
STT_LANGUAGE=en
FASTER_WHISPER_MODEL_SIZE=base.en
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_BEAM_SIZE=1

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://YOUR_FRONTEND_DOMAIN/oauth/kakao/callback
KAKAO_TOKEN_URL=https://kauth.kakao.com/oauth/token
KAKAO_USER_INFO_URL=https://kapi.kakao.com/v2/user/me

LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=12
OLLAMA_EMBEDDED=false
